{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nguyenhuy158/healthchecksio-mcp",
  "description": "MCP server for Healthchecks.io API",
  "repository": {
    "url": "https://github.com/nguyenhuy158/healthchecksio-mcp",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "healthchecksio-mcp",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Healthchecks.io API key",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "HEALTHCHECKS_API_KEY"
        }
      ]
    }
  ]
}
